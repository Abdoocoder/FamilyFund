# Clerk Authentication
# Get from: https://dashboard.clerk.com/~/api-keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Convex Backend
# Get from: `npx convex dev` output or Convex Dashboard
VITE_CONVEX_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.convex.cloud

# Convex Auth Config (set in Convex Dashboard, not needed in .env.local)
# CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev
# Clerk Configurations
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWT_ISSUER_DOMAIN=https://...

# Convex Configurations
VITE_CONVEX_URL=https://...
VITE_CONVEX_SITE_URL=https://...
CONVEX_DEPLOY_KEY=prod:...
